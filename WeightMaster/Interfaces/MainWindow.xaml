                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Logout image -->
                                <Image Source="/Interfaces/settings_button.png" Height="52" Width="52"/>
                                <TextBlock Text="සැකසුම්" Foreground="White" FontSize="16" FontWeight="Normal" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Button>
                    <!--Home button (when home button is invicible)-->
                    <Button x:Name="HomeButton" Visibility="Hidden" Background="Transparent" BorderThickness="0" Margin="1413,0,168,0" Style="{StaticResource HoverButton}" Click="HomeButtonClick">
                        <Border Background="#D9D9D9" CornerRadius="30" Padding="10" Width="120" Height="120">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Home image -->
                                <Image Source="/Interfaces/home_button.png" Height="52" Width="52"/>
                                <TextBlock Text="ආපසු" Foreground="White" FontSize="16" FontWeight="Normal" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Button>

                    <!--Logout button-->
                    <Button Background="Transparent" BorderThickness="0" Margin="1666,0,26,0" Style="{StaticResource HoverButton}" Click="LogoutButtonClick">
                        <Border Background="#2DAA44" CornerRadius="30" Padding="10" Width="120" Height="120">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Logout image -->
                                <Image Source="/Interfaces/logouot_button.png" Height="52" Width="52"/>
                                <TextBlock Text="ඉවත් වීම" Foreground="White" FontSize="16" FontWeight="Normal" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Button>
                </Grid>
            </Border>
            <!--Station1Frame-->
            <Grid x:Name="Station1Frame" Visibility="Visible" Background="White" Margin="10,150,10,10">
                <Border Background="#FBFBFB" CornerRadius="20" Margin="25,35,1379,523" BorderThickness="2" BorderBrush="#ECECEC">
                    <Grid>
                        <!-- Transport Method Dropdown -->
                        <Grid Margin="21,89,26,81">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="25"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="අධීක්ෂණය" FontSize="12" Foreground="#616161" HorizontalAlignment="Left" Margin="0,0,0,0"/>
                            <ComboBox Style="{StaticResource CustomComboBoxStyle}" Grid.Row="1"  >
                                <ComboBoxItem Content="Katujurunda"/>
                                <ComboBoxItem Content="Haggala"/>
                                <ComboBoxItem Content="Nuwara-Eliya"/>
                            </ComboBox>
                        </Grid>
                        <!--weight leaf officer textbox-->
                        <Grid  Margin="26,19,26,174" >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="දළු කිරුම් නිලධාරී" FontSize="12" Foreground="#616161" HorizontalAlignment="Left" />
                            <Border Grid.Row="1" Background="#F7F7F7" CornerRadius="10" BorderBrush="#C4C4C4" BorderThickness="2" Padding="2" Margin="0,0,0,5">
                                <TextBox Background="#F7F7F7" BorderThickness="0" Foreground="Black" FontSize="14" VerticalAlignment="Top" Height="23" Margin="0,4,0,0"/>
                            </Border>
                        </Grid>

                        <!--Confirm button-->
                        <Button Background="Transparent" BorderThickness="0" Margin="48,182,48,37" Style="{StaticResource HoverButton}">
                            <Border Background="#2DAA44" CornerRadius="8" Padding="10" Height="36" Width="305">
                                <TextBlock Text="CONFIRM" Foreground="White" FontSize="12" FontWeight="Normal" HorizontalAlignment="Center"/>
                            </Border>
                        </Button>
                    </Grid>
                </Border>

                <Border BorderThickness="2" BorderBrush="#ECECEC" Background="#FBFBFB" CornerRadius="20" Margin="26,334,1379,80">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="190"/>
                            <RowDefinition Height="90"/>
                            <RowDefinition Height="50"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,30,0,0">
                            <Ellipse Width="20" Height="20" Fill="#2DAA44" Margin="20,0,10,0"/>
                            <TextBlock Text="Connected" Foreground="#BFBFBF" FontSize="15" FontWeight="SemiBold" Margin="5,0,0,0" />
                        </StackPanel>
                        <TextBlock VerticalAlignment="Bottom" Grid.Row="1" Text="36.5KG" Foreground="Black" FontSize="96" FontWeight="Bold" Margin="10,22,12,0"  />
                        <TextBlock VerticalAlignment="Top" Grid.Row="2" Text="සමබරයි" Foreground="#4E56FF" FontSize="45" FontWeight="SemiBold" Margin="32,0,0,0" />
                        <!--Confirm buttonn-->
                        <Button  Grid.Row="3"  Background="Transparent" BorderThickness="0" Style="{StaticResource HoverButton}">
                            <Border Background="#2DAA44" CornerRadius="8" Padding="10" Height="36" Width="310">
                                <TextBlock Text="CONFIRM" Foreground="White" FontSize="12" FontWeight="Normal" HorizontalAlignment="Center"/>
                            </Border>
                        </Button>
                    </Grid>
                </Border>

                <Border BorderThickness="2" BorderBrush="#ECECEC" Background="#FBFBFB" CornerRadius="20" Margin="467,35,763,78">
                    <Grid>
                        <!-- Transport Route Dropdown -->
                        <Grid Margin="33,22,308,620">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="25"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="ප්‍රවාහන මාර්ගය" FontSize="12" Foreground="#616161" HorizontalAlignment="Left" Margin="0,0,0,0"/>
                            <ComboBox Style="{StaticResource CustomComboBoxStyle}" Grid.Row="1"  >
                                <ComboBoxItem Content="Katujurunda"/>
                                <ComboBoxItem Content="Haggala"/>
                                <ComboBoxItem Content="Nuwara-Eliya"/>
                            </ComboBox>
                        </Grid>

                        <!-- Transport Agent Dropdown -->
                        <Grid Margin="33,92,308,550">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="25"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="ප්‍රවාහන නියෝජිත" FontSize="12" Foreground="#616161" HorizontalAlignment="Left" Margin="0,0,0,0"/>
                            <ComboBox Style="{StaticResource CustomComboBoxStyle}" Grid.Row="1"  >
                                <ComboBoxItem Content="H.M.K. Kavinda"/>
                                <ComboBoxItem Content="K.K. Wenuja"/>
                                <ComboBoxItem Content="Guest"/>
                            </ComboBox>
                        </Grid>

                        <!--company textbox-->
                        <Grid Margin="33,160,308,476" >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Company" FontSize="12" Foreground="#616161" HorizontalAlignment="Left" />
                            <Border Grid.Row="1" Height="38" Background="#F7F7F7" CornerRadius="10" BorderBrush="#C4C4C4" BorderThickness="2" Padding="2">
                                <TextBox Background="#F7F7F7" BorderThickness="0" Foreground="Black" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                            </Border>
                        </Grid>

                        <!-- Member barcode id TextBox -->
                        <Grid Margin="310,19,36,617" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Height="60">
                                <TextBlock Grid.Row="0" Text="බාර් කේතය" FontSize="12" Foreground="#616161" HorizontalAlignment="Left" Margin="0,0,0,37"/>
                                <Border Background="#F7F7F7" CornerRadius="10" BorderBrush="#C4C4C4" BorderThickness="2" Padding="2" Margin="0,22,0,0">
                                    <TextBox Background="#F7F7F7" BorderThickness="0" Foreground="Black" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                                </Border>
                            </Grid>
                            <!-- qr Button -->
                            <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Margin="10,24,0,0">
                                <Border Background="#2DAA44" CornerRadius="10" Padding="12">
                                    <Image Source="/Interfaces/qr_icon.png"/>
                                </Border>
                            </Button>
                        </Grid>
                        <!--pre-r textbox-->
                        <Grid Margin="310,94,36,542" >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="පූර්ව සාමාජික අංකය" FontSize="12" Foreground="#616161" HorizontalAlignment="Left" />
                            <Border Grid.Row="1" Height="38" Background="#F7F7F7" CornerRadius="10" BorderBrush="#C4C4C4" BorderThickness="2" Padding="2">
                                <TextBox Background="#F7F7F7" BorderThickness="0" Foreground="Black" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                            </Border>
                        </Grid>
                        <!--member/Ex-Member No textbox-->
                        <Grid Margin="310,160,36,476" >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="මුලකරු සමග නම" FontSize="12" Foreground="#616161" HorizontalAlignment="Left" />
                            <Border Grid.Row="1" Height="38" Background="#F7F7F7" CornerRadius="10" BorderBrush="#C4C4C4" BorderThickness="2" Padding="2">
                                <TextBox Background="#F7F7F7" BorderThickness="0" Foreground="Black" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                            </Border>
                        </Grid>

                        <!-- nSacks TextBox -->
                        <Grid Margin="33,231,308,412">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Margin="0,0,10,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="20"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="මලු ගණන" FontSize="12" Foreground="#616161" HorizontalAlignment="Left" />
                                <Border Grid.Row="1" Height="38" Background="#F7F7F7" CornerRadius="10" BorderBrush="#C4C4C4" BorderThickness="2" Padding="2">
                                    <TextBox PreviewTextInput="TextBox_PreviewTextInput" Background="#F7F7F7" BorderThickness="0" Foreground="Black" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                                </Border>
                            </Grid>
                            <!-- Tick Button -->
                            <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Margin="0,19,0,0" Style="{StaticResource HoverButton}">
                                <Border Background="#2DAA44" CornerRadius="10" Padding="12">
                                    <Image Source="/Interfaces/tick.png"/>
                                </Border>
                            </Button>
                        </Grid>

                        <!-- nBoxes TextBox -->
                        <Grid Margin="310,231,36,412">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Margin="0,0,10,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="20"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="පෙට්ටි ගණන" FontSize="12" Foreground="#616161" HorizontalAlignment="Left" />
                                <Border Grid.Row="1" Height="38" Background="#F7F7F7" CornerRadius="10" BorderBrush="#C4C4C4" BorderThickness="2" Padding="2">
                                    <TextBox PreviewTextInput="TextBox_PreviewTextInput" Background="#F7F7F7" BorderThickness="0" Foreground="Black" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                                </Border>
                            </Grid>
                            <!-- Tick Button -->
                            <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Margin="0,19,0,0" Style="{StaticResource HoverButton}">
                                <Border Background="#2DAA44" CornerRadius="10" Padding="12">
                                    <Image Source="/Interfaces/tick.png"/>
                                </Border>
                            </Button>
                        </Grid>
