<Window x:Class="WeightMaster.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WeightMaster"
        
        xmlns:userContorls="clr-namespace:WeightMaster.Interfaces.UserControls"
        mc:Ignorable="d"
        Title="MainWindow" Height="1080" Width="1920"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="White"
        WindowStartupLocation="CenterScreen">

    <!-- Merging the external ResourceDictionary containing styles -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="general_styles.xaml"/>
                <ResourceDictionary Source="custom_styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>


    <Grid>

        <!--Close button-->
        <Button Click="CloseButton_Click" 
        HorizontalAlignment="Left" 
        Margin="1875,16,0,0" 
        VerticalAlignment="Top" 
        Height="28" 
        Width="30" 
        Background="{x:Null}" 
        BorderBrush="{x:Null}" 
        Cursor="Hand">

            <!--close button-->
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Image x:Name="closeImage" Height="23" Width="23" VerticalAlignment="Top" 
                       Source="/Interfaces/close_button.png" RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                                <ScaleTransform x:Name="scaleTransform" ScaleX="1" ScaleY="1"/>
                            </Image.RenderTransform>
                        </Image>
                    </Grid>


                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>

                                        <DoubleAnimation
                                    Storyboard.TargetName="closeImage"
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                    To="0.8" Duration="0:0:0.2"/>
                                        <DoubleAnimation
                                    Storyboard.TargetName="closeImage"
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                    To="0.8" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>

                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                    Storyboard.TargetName="closeImage"
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                    To="1" Duration="0:0:0.2"/>
                                        <DoubleAnimation
                                    Storyboard.TargetName="closeImage"
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                    To="1" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!--Status label-->
        <Label x:Name="statusLabel" Content="Syncing..." HorizontalAlignment="Left" Margin="34,1026,0,0" VerticalAlignment="Top" Foreground="#FFA5A5A5" FontSize="16"/>




        <Label Visibility="Hidden" Content="Weight Value" HorizontalAlignment="Center" Margin="0,252,0,0" VerticalAlignment="Top" FontSize="36"/>
        <Label Visibility="Hidden" Content="0.0" HorizontalAlignment="Center" Margin="0,39,0,0" VerticalAlignment="Top" FontSize="160" RenderTransformOrigin="0.5,0.556"/>


        <!--Intro Frame-->
        <Grid x:Name="IntroFrame" Visibility="Hidden" Background="White" Margin="38,49,40,49" >
            <Border Background="White" CornerRadius="20" Margin="728,36,728,86">

                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="20,0">

                        <Border Height="100" Width="100" BorderBrush="#F0F0F0" BorderThickness="10" CornerRadius="10">
                            <Image Source="/Interfaces/teacoop_logo.png" Stretch="Uniform" />
                        </Border>
                        <!--
                        <Image gif:ImageBehavior.AnimatedSource="/Interfaces/loading.gif" Height="150" Width="150"/>
                        -->
                        <!-- Animation trigger-->
                    </StackPanel>
                    <Grid Grid.Row="2">
                        <TextBlock VerticalAlignment="Top" Margin="125,728,107,0" FontSize="24" FontWeight="Bold">
                            <Run Text="POS" Foreground="Black" />
                            <Run Text="Plus" Foreground="#1D8348" />
                        </TextBlock>

                        <TextBlock Text="Build No. 001EX" Foreground="#666666" VerticalAlignment="Top" Margin="93,765,67,0" FontSize="24"/>
                    </Grid>

                </Grid>
            </Border>
        </Grid>


        <!--Login Frame-->
        <Grid x:Name="LoginFrame" Visibility="Hidden" Background="White" Margin="38,49,40,49" >
            <Border Background="White" CornerRadius="20" Margin="728,36,728,86">
                <Grid Margin="0,72,0,0">
                    <StackPanel  Margin="20,98,20,305">
                        <TextBlock Text="වේදිකාව" FontSize="32" Foreground="#1D8348" Margin="0,0,0,8" FontWeight="SemiBold"/>
                        <TextBlock Text="ඔබගේ පරිශීලක තොරතුරු මෙහි අතුලත් පෞද්ගලික සැකසුම් කර ඔබගේ ගිණුමට, පරිශීලක පුවරුවට, පෞද්ගලික සැකසුම් වෙත  පිවිසෙන්න"
                         TextWrapping="Wrap" 
                         Foreground="#666666" 
                         FontSize="14" 
                         Margin="0,0,0,32"/>

                        <TextBox x:Name="UsernameTextBox"
                         Height="60" 
                         Style="{StaticResource CustomTextBox}"
                         Margin="0,0,0,16"/>

                        <Grid Margin="0,0,0,24">
                            <PasswordBox x:Name="PasswordTextBox"
                         Height="60"
                         Style="{StaticResource CustomPasswordBox}"
                         Margin="0,0,0,16"/>


                            <Button HorizontalAlignment="Right" 
                    Style="{StaticResource PasswordVisibilityToggle}"
                    Click="TogglePasswordVisibilityClick" Margin="0,0,10,16" Width="30">
                                <Path x:Name="VisibilityIcon"
                      Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"
                      Fill="#666666" Stretch="Uniform" Width="16" Height="16"/>
                            </Button>
                        </Grid>
                    </StackPanel>


                    <!--Station 1 radio button-->
                    <RadioButton x:Name="RadioBtnStation1" GroupName="LoginPathGroup"  Background="Transparent" BorderThickness="0" Margin="20,386,200,338">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="Border" Background="#2ECC71" CornerRadius="18" Padding="10" Width="163" Height="60">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- White Ellipse -->
                                        <Ellipse Width="20" Height="20" Fill="White" Margin="0,0,10,0"/>
                                        <!-- Button Text -->
                                        <TextBlock Text="වේදිකාව-1" Foreground="White" FontSize="16" FontWeight="Normal" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <!-- When not checked, you can reduce opacity (or change styling) -->
                                    <Trigger Property="IsChecked" Value="False">
                                        <Setter TargetName="Border" Property="Opacity" Value="0.7"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>

                    <!--Station 2 radio button-->
                    <RadioButton x:Name="RadioBtnStation2" GroupName="LoginPathGroup" Background="Transparent" BorderThickness="0" Margin="200,386,20,338">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="Border" Background="#2ECC71" CornerRadius="18" Padding="10" Width="163" Height="60">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- White Ellipse -->
                                        <Ellipse Width="20" Height="20" Fill="White" Margin="0,0,10,0"/>
                                        <!-- Button Text -->
                                        <TextBlock Text="වේදිකාව-2" Foreground="White" FontSize="16" FontWeight="Normal" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="False">
                                        <Setter TargetName="Border" Property="Opacity" Value="0.7"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>

                    <!--Admin Access radio button-->
                    <RadioButton x:Name="RadioBtnAdmin" GroupName="LoginPathGroup" Background="Transparent" BorderThickness="0" Margin="20,455,20,269">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="Border" Background="#2ECC71" CornerRadius="18" Padding="10" Width="336" Height="60">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- White Ellipse -->
                                        <Ellipse Width="20" Height="20" Fill="White" Margin="0,0,10,0"/>
                                        <!-- Button Text -->
                                        <TextBlock Text="ප්‍රධාන පාලක" Foreground="White" FontSize="16" FontWeight="Normal" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="False">
                                        <Setter TargetName="Border" Property="Opacity" Value="0.7"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>
                    <!--Login button-->
                    <Button Background="Transparent" BorderThickness="0" Margin="20,524,20,200" Click="LoginButtonClick" >
                        <Border Background="#2ECC71" CornerRadius="18" Padding="10" Width="336" Height="60">
                            <Image Source="/Interfaces/login_button.png"/>
                        </Border>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!--Station Main Frame-->
        <Grid x:Name="StationMainFrame" Visibility="Visible" Background="White" Margin="40,50,40,50" >
            <!--Top bar-->
            <Border Background="#FBFBFB" Margin="10,8,10,836" CornerRadius="20">
                <Grid>
                    <Image Source="/Interfaces/station_1_image.png" Margin="0,26,1635,16"/>
                    <TextBlock x:Name="TopBarText" Text="වේදිකාව-1" FontSize="46" Margin="161,17,1207,44" FontWeight="Bold"  />
                    <TextBlock x:Name="TopBarDate" Text="2024-12-14" FontSize="24" Margin="168,81,1433,24" FontWeight="Medium"  />
                    <!--Settings button (when home button is invicible)-->
                    <Button x:Name="SettingsButton" Visibility="Visible" Background="Transparent" BorderThickness="0" Margin="1524,0,168,0" Style="{StaticResource HoverButton}" Click="SettingsButtonClick">
