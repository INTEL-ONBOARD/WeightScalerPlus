<UserControl x:Class="WeightMaster.Interfaces.UserControls.CustomerBillTableRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WeightMaster.Interfaces.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="1080">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../general_styles.xaml"/>
                <ResourceDictionary Source="../custom_styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Button Cursor="Hand" x:Name="fdshg1"  Padding="0" Background="Transparent" BorderThickness="0" Style="{StaticResource HoverButton}">
            <Border Width="990" Height="50" Margin = "0,10,0,0" Background="#F5F5F5" BorderBrush="#D9D9D9" BorderThickness="0,0,0,2" CornerRadius="10" Padding="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="240" />
                    </Grid.ColumnDefinitions>
                    <TextBox Margin="16,0,0,0" Grid.Column="0" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="20" Text="1" x:Name="memberNo" Foreground="#FF0078D7"/>
                    <TextBox Margin="0,0,15,0" Grid.Column="1" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="20" Text="714351" x:Name="roundNo" Foreground="#FF0078D7"/>
                    <TextBox Margin="0,0,15,0" Grid.Column="2" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="20" Text="2001-01-31" x:Name="sacksCount" Foreground="#FF0078D7"/>
                    <TextBox Margin="0,0,15,0" Grid.Column="3" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="20" Text="මිල්ලව" x:Name="boxCount" Foreground="#FF0078D7"/>
                </Grid>
            </Border>
        </Button>
    </Grid>
    
</UserControl>
