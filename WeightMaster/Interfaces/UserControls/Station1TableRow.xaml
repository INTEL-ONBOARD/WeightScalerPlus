<UserControl x:Class="WeightMaster.Interfaces.UserControls.Station1TableRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WeightMaster.Interfaces.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Border Width="680" Height="50" Margin = "0,10,0,0" Background="#F5F5F5" BorderBrush="#D9D9D9" BorderThickness="0,0,0,2" CornerRadius="10" Padding="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <TextBox Margin="0,0,15,0" Grid.Column="0" Background="Transparent" BorderThickness="0" Foreground="#8E8E8E" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" Text="#1" x:Name="roundNo"/>
                <TextBox Margin="0,0,15,0" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="#8E8E8E" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" Text="20" x:Name="sacksCount"/>
                <TextBox Margin="0,0,15,0" Grid.Column="2" Background="Transparent" BorderThickness="0" Foreground="#8E8E8E" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" Text="0" x:Name="boxCount"/>
                <TextBox Margin="0,0,15,0" Grid.Column="3" Background="Transparent" BorderThickness="0" Foreground="#8E8E8E" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" Text="460kg" x:Name="acceptedWeight"/>
                <TextBox Margin="0,0,15,0" Grid.Column="4" Background="Transparent" BorderThickness="0" Foreground="#8E8E8E" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" Text="100kg" x:Name="goldLeafWeight"/>
                <TextBox Margin="0,0,15,0" Grid.Column="5" Background="Transparent" BorderThickness="0" Foreground="#8E8E8E" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" Text="360kg" x:Name="generalLeafWeight"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
