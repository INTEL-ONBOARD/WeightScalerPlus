<UserControl x:Class="WeightMaster.Interfaces.UserControls.CustomerCompletionTableRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WeightMaster.Interfaces.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../general_styles.xaml"/>
                <ResourceDictionary Source="../custom_styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Button Cursor="Hand" x:Name="RowButton"  Padding="0" Background="Transparent" BorderThickness="0" Style="{StaticResource HoverButton}">
        <Border x:Name="RowBorder" Width="690" Height="50" Margin="0,10,0,0" Background="#F5F5F5" BorderBrush="#D9D9D9" BorderThickness="0,0,0,2" CornerRadius="10" Padding="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="90" />
                    <!--<ColumnDefinition Width="80" />-->
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <TextBox Margin="0,0,15,0" Grid.Column="0" IsReadOnly="True"  IsEnabled="False" Background="Transparent" BorderThickness="0" Foreground="#8E8E8E" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" Text="XLR9594943" x:Name="memberNo"/>
                <TextBox Margin="0,0,15,0" Grid.Column="1" IsReadOnly="True"  IsEnabled="False" Background="Transparent" BorderThickness="0" Foreground="#8E8E8E" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" Text="Mr. Kulathunga" x:Name="name"/>
                <TextBox Margin="0,0,15,0" Grid.Column="2" IsReadOnly="True"  IsEnabled="False" Background="Transparent" BorderThickness="0" Foreground="#8E8E8E" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" Text="6" x:Name="sackCount"/>
                <!--<TextBox Margin="0,0,15,0" Grid.Column="3" IsReadOnly="True"  IsEnabled="False" Background="Transparent" BorderThickness="0" Foreground="#8E8E8E" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" Text="0" x:Name="remainingSackCount"/>-->
                <TextBox Margin="0,0,15,0" Grid.Column="4" IsReadOnly="True"  IsEnabled="False" Background="Transparent" BorderThickness="0" Foreground="#8E8E8E" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" Text="320kg" x:Name="totalLeafWeight"/>
                <TextBox Margin="0,0,15,0" Grid.Column="5" IsReadOnly="True"  IsEnabled="False" Background="Transparent" BorderThickness="0" Foreground="#8E8E8E" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" Text="320kg" x:Name="acceptedLeafWeight"/>
                <TextBox Margin="0,0,15,0" Grid.Column="6" IsReadOnly="True"  IsEnabled="False" Background="Transparent" BorderThickness="0" Foreground="#8E8E8E" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" Text="200kg" x:Name="goldLeafWeight"/>
            </Grid>
        </Border>
    </Button>
</UserControl>
