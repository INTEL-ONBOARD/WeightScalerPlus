<UserControl x:Class="WeightMaster.Interfaces.UserControls.StataionDateAndTime"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WeightMaster.Interfaces.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="60" Width="403">
    <Grid Background="Transparent">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock x:Name="DateTextBlock" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="26" FontWeight="SemiBold" Foreground="#586C79" Text="00 - 00 - 0000"/>
            <!--Vertical lining upper middle-->
            <Line X1="0" X2="0" Y1="12" Y2="42" Margin="10,0,10,0" Stroke="#586C79" StrokeThickness="2"/>
            <TextBlock x:Name="TimeTextBlock" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="26" FontWeight="SemiBold" Foreground="#586C79" Text="0.00 am"/>
        </StackPanel>
    </Grid>
</UserControl>
